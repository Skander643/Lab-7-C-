@page "/dashboard"
@using DashboardData.Models
@using DashboardData.Services
@using DashboardData.Components.UI
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject ISensorService SensorService
@inject NavigationManager NavManager

<PageTitle>Mon Dashboard Data</PageTitle>

<h1>Tableau de Bord</h1>

<div class="alert-info mb-3 p-2">
    Bienvenue sur l'interface de pilotage.
    Nous sommes le : <strong>@DateTime.Now.ToString("dd MMM yyyy")</strong>
</div>

<!-- In MyDashboard.razor -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <!-- Parameters are passed like simple HTML attributes -->
        <KpiCard Title="Total Sensors" Value="@TotalSensors.ToString()"
                 BackgroundColorClass="bg-primary" IconClass="bi-box-seam" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Global Average" Value="@($"{AverageValue:F1} °C")"
                 BackgroundColorClass="bg-success" IconClass="bi-bullseye" />
    </div>
    <div class="col-md-4 mb-3">
        <KpiCard Title="Max Alert" Value="@($"{MaxValue:F1} °C")"
                 BackgroundColorClass="bg-danger" IconClass="bi-exclamation-triangle-fill" />
    </div>
</div>
<div class="mb-3">
    Status du système :
    @if (IsSystemOK)
    {
        <span class="badge bg-success">Opérationnel</span>
    }
    else
    {
        <span class="badge bg-danger">Erreur Critique</span>
    }
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="AddNewSensor">Add New</button>
    <button class="btn btn-secondary" @onclick="LoadAll">All Sensors</button>
    <button class="btn btn-danger" @onclick="LoadCritical">Alerts (> 30.0)</button>
</div>

<a href="/edit-sensor" class="btn btn-success mb-3">+ Nouveau Capteur</a>

<button class="btn btn-outline-secondary mb-3" @onclick="() => ShowAsCards = !ShowAsCards">
    <i class="bi bi-arrow-left-right"></i> Toggle View
</button>

@if (_isLoading)
{
    <p><em>Chargement des données...</em></p>
}
else if (Sensors == null)
{
    <p>Aucune donnée disponible.</p>
}
else
{
    @if (ShowAsCards)
    {
        <div class="row">
            @foreach (var s in Sensors)
            {
                <div class="col-md-3 mb-3">
                    <SensorCard Sensor="s" />
                </div>
            }
        </div>
    }
    else
    {
        <!-- Link the child's event to the parent's DeleteSensor method -->
        <SensorTable Sensors="Sensors" OnDeleteClicked="deleteSensorAsync" />
    }
}

@code {
    private bool IsSystemOK = true;
    private bool _isLoading = true;
    private List<SensorData>? Sensors;
    private bool ShowAsCards = false;

    private int TotalSensors ;
    private double AverageValue ;

    private double MaxValue ;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        await getTotalSensors();
        await getAverageValue();
        await getMaxValue();
    }

    private async Task LoadAll()
    {
        _isLoading = true;
        Sensors = await SensorService.GetSensorsAsync();
        _isLoading = false;
    }

    private async Task LoadCritical()
    {
        _isLoading = true;
        Sensors = await SensorService.GetCriticalSensorsAsync(30.0);
        _isLoading = false;
    }

    private async Task getTotalSensors()
    {
        TotalSensors = await SensorService.GetTotalCountAsync();
    }

    private async Task getMaxValue()
    {
        MaxValue = await SensorService.GetMaxValueAsync();
    }

     private async Task getAverageValue()
    {
        AverageValue = await SensorService.GetAverageValueAsync();
    }


    private void AddNewSensor(MouseEventArgs args)
    {
        NavManager.NavigateTo("/add-sensor");
    }

    private async Task deleteSensorAsync(int id)
    {
        await SensorService.DeleteSensorAsync(id);
        await LoadAll(); // Refresh the list after deletion
    }
}